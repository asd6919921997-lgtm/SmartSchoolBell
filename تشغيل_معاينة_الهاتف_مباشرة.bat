@echo off
chcp 65001 > nul
title تشغيل محاكي ومعاينة الهاتف الذكي 100% - المنبه المدرسي
color 0b

echo ===================================================================
echo     📱 المنبه والجرس المدرسي الذكي - محاكي الهاتف الحي 100%
echo ===================================================================
echo.
echo [1] جاري التحقق من بيئة التشغيل وتفعيل خادم المعاينة المباشر...

:: التحقق من توفر Python لتشغيل خادم محلي يتيح التخزين الكامل والصوت بنسبة 100%
where python >nul 2>nul
if %ERRORLEVEL% EQU 0 (
    echo [2] تم رصد بايثون - جاري بدء خادم محلي فائق السرعة على المنفذ 8085...
    start /B python -m http.server 8085 --bind 127.0.0.1 >nul 2>&1
    ping 127.0.0.1 -n 2 > nul
    echo [3] تشغيل المحاكي عبر الخادم المحلي: http://localhost:8085
    start "" "http://localhost:8085/معاينة_الهاتف_الذكي.html"
) else (
    where node >nul 2>nul
    if %ERRORLEVEL% EQU 0 (
        echo [2] جاري تشغيل الخادم عبر Node.js...
        start /B npx --yes serve -l 8085 . >nul 2>&1
        ping 127.0.0.1 -n 2 > nul
        start "" "http://localhost:8085/معاينة_الهاتف_الذكي.html"
    ) else (
        echo [2] جاري الفتح المباشر للمحاكي بالمتصفح...
        start "" "معاينة_الهاتف_الذكي.html"
    )
)

echo.
echo ===================================================================
echo    ✅ تم تشغيل المعاينة بنجاح في متصفحك!
echo    💡 يمكنك الضغط على (🔄 تحديث فوري) داخل المحاكي لمشاهدة أي تعديل.
echo ===================================================================
echo.
timeout /t 3 > nul
exit
